# FigmaSync — Variables de entorno
# Copiar este archivo como .env y llenar los valores

# Figma Personal Access Token (PAT)
# Obtener en: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=figd_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Figma File Key del proyecto activo
# Extraer de la URL: https://figma.com/design/{FILE_KEY}/{fileName}
FIGMA_FILE_KEY=

# Figma File URL completa (opcional, alternativa a FILE_KEY)
FIGMA_FILE_URL=

# Puerto del WebSocket para figma-console-mcp (default: 9223)
FIGMA_CONSOLE_PORT=9223
